APP_NAME=Smart Maintenance Logbook API
APP_ENV=local
DATABASE_URL=sqlite:///./data/smart_logbook.sqlite3
# For a separate local PostgreSQL DB, use:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/smart_maintenance_logbook
UPLOAD_DIR=./uploads
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8101
FRONTEND_ORIGIN=http://127.0.0.1:3101
ENABLE_WHISPER=false
WHISPER_MODEL=small
